# Copy to .env on the VPS and fill in values before deploying.

# Public hostname (must resolve to your VPS)
DOMAIN=automation.promiseschool.com

# n8n
N8N_HOST=automation.promiseschool.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
# Required for $env.META_VERIFY_TOKEN in workflow expressions
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Allow Read/Write Files node to read mounted ./knowledge (semicolon for multiple paths)
N8N_RESTRICT_FILE_ACCESS_TO=/knowledge

# Meta / Facebook Messenger
META_VERIFY_TOKEN=change-me-to-a-secret-verify-token
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0
META_PAGE_ID=
# Optional: enables ./scripts/setup-meta.sh to subscribe app webhook fields (messages)
# Find App ID + App Secret in Meta Developer → App settings → Basic
META_APP_ID=
META_APP_SECRET=

# Ollama (qwen3:8b needs ~8GB RAM; use qwen2.5:3b on smaller VPS)
OLLAMA_MODEL=qwen3:8b

# Promise School support
SUPPORT_EMAIL=support@promiseschool.com
SITE_URL=https://www.promiseschool.app
HOBBYCAMP_URL=https://www.promiseschool.app/hobbycamp

# Optional: email alerts when a conversation is escalated
ESCALATION_NOTIFY_EMAIL=
