      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst q = item.query ?? item.params ?? {};\nreturn [{\n  json: {\n    ...item,\n    hubMode: String(q['hub.mode'] ?? item['hub.mode'] ?? ''),\n    hubVerifyToken: String(q['hub.verify_token'] ?? item['hub.verify_token'] ?? ''),\n    hubChallenge: String(q['hub.challenge'] ?? item['hub.challenge'] ?? ''),\n  },\n}];"
      },
