      "id": "a1000001-0001-4000-8000-00000000000c",
      "name": "Ollama Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, 620]
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Prompt').item.json;\nconst ollama = $input.first().json;\nlet replyText = ollama.message?.content?.trim() || '';\n\nif (!replyText) {\n  replyText = \"Thanks for messaging Promise School! A team member will follow up soon. You can also email support@promiseschool.com.\";\n}\n\nconst unsurePatterns = [\n  \"i don't know\",\n  \"i do not know\",\n  \"not sure\",\n  \"cannot find\",\n  \"can't find\",\n  \"unable to answer\"\n];\n\nconst lower = replyText.toLowerCase();\nif (unsurePatterns.some((p) => lower.includes(p))) {\n  replyText = \"I'm not fully sure about that one — please email support@promiseschool.com and our team will help you directly.\";\n}\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.conversations) staticData.conversations = {};\nif (!staticData.conversations[prep.senderId]) staticData.conversations[prep.senderId] = [];\n\nstaticData.conversations[prep.senderId].push(\n  { role: 'user', content: prep.text },\n  { role: 'assistant', content: replyText }\n);\n\nif (staticData.conversations[prep.senderId].length > 20) {\n  staticData.conversations[prep.senderId] = staticData.conversations[prep.senderId].slice(-20);\n}\n\nreturn [{\n  json: {\n    senderId: prep.senderId,\n    replyText,\n    needsEscalation: prep.needsEscalation || false,\n    userText: prep.text\n  }\n}];"
      },
