    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst entry = body.entry?.[0];\nconst messaging = entry?.messaging?.[0];\n\nif (!messaging) {\n  return [{ json: { skip: true, reason: 'no_messaging_event' } }];\n}\n\nif (messaging.message?.is_echo) {\n  return [{ json: { skip: true, reason: 'echo' } }];\n}\n\nconst text = messaging.message?.text?.trim();\nif (!text) {\n  return [{ json: { skip: true, reason: 'no_text' } }];\n}\n\nconst senderId = messaging.sender?.id;\nconst messageId = messaging.message?.mid;\n\nreturn [{\n  json: {\n    skip: false,\n    senderId,\n    messageId,\n    text,\n    timestamp: messaging.timestamp\n  }\n}];"
      },
